{
  "name": "blog-website",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix client install",
    "dev:backend": "npm --prefix backend run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "npx --yes concurrently -n api,web -c blue,green \"npm:dev:backend\" \"npm:dev:client\"",
    "build": "npm --prefix backend run build && npm --prefix client run build",
    "db:migrate": "npm --prefix backend run prisma:migrate",
    "db:seed": "npm --prefix backend run prisma:seed"
  }
}
